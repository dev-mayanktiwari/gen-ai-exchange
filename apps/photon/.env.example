NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret

# Vault Service Configuration
VAULT_URL=http://localhost:4001
VAULT_API_KEY=your_secure_vault_api_key_here

# Firebase API key is now handled by vault service

# Storage Configuration
RAW_UPLOAD_BUCKET=your_gcs_bucket_name
USE_VAULT_FOR_STORAGE=false
